{
  "name": "aipomoea",
  "productName": "AIpomoea",
  "version": "1.3.0",
  "description": "Tecnologia em Fenotipagem e Classificação de Batata-doce",
  "main": "main.js",
  "homepage": "https://github.com/NEPEM-UFSC/AIpomoea",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --inspect=5858",
    "debug": "set DEBUG=true && electron . --inspect=5858",
    "test": "pwsh -ExecutionPolicy Bypass -File ./tests/run-tests.ps1",
    "test:python": "pytest tests/ -v",
    "test:smoke": "pytest tests/test_smoke.py -v",
    "test:unit": "pytest tests/unit/ -v",
    "test:integration": "pytest tests/integration/ -v",
    "test:coverage": "pytest tests/ --cov=src_python --cov-report=html --cov-report=term",
    "lint": "npm run lint:python",
    "lint:python": "cd src_python && flake8 src/ main.py",
    "format": "npm run format:python",
    "format:python": "cd src_python && black src/ main.py && isort src/ main.py",
    "format:check": "cd src_python && black --check src/ main.py && isort --check-only src/ main.py",
    "verify-build": "pwsh -ExecutionPolicy Bypass -File ./scripts/verify-build-contents.ps1",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "build": "npm run dist",
    "build:win": "npm run dist:win",
    "build:mac": "npm run dist:mac",
    "build:linux": "npm run dist:linux",
    "postinstall": "electron-builder install-app-deps",
    "clean": "rimraf dist",
    "rebuild": "npm run clean && npm install && npm run dist"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NEPEM-UFSC/AIpomoea.git"
  },
  "keywords": [
    "electron",
    "sweet-potato",
    "phenotyping",
    "computer-vision",
    "machine-learning",
    "agriculture",
    "plant-analysis"
  ],
  "author": {
    "name": "NEPEM - UFSC",
    "email": "nepem@ufsc.br",
    "url": "https://github.com/NEPEM-UFSC"
  },
  "license": "CC0-1.0",
  "bugs": {
    "url": "https://github.com/NEPEM-UFSC/AIpomoea/issues"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^24.13.3",
    "rimraf": "^5.0.5"
  },
  "dependencies": {
    "winston": "^3.13.1"
  },
  "build": {
    "appId": "com.nepem.aipomoea",
    "productName": "AIpomoea",
    "copyright": "Copyright © 2025 NEPEM-UFSC",
    "asar": true,
    "asarUnpack": [
      "models/**/*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "PythonEnvManager.js",
      "logger.js",
      "package.json",
      "LICENSE.md",
      "views/**/*",
      "static/**/*",
      "models/**/*",
      "!**/*.test.js",
      "!**/*.spec.js",
      "!**/*.test.py",
      "!**/*.md",
      "!**/tests/",
      "!**/test/",
      "!**/__pycache__/",
      "!**/.pytest_cache/",
      "!**/.coverage",
      "!**/htmlcov/",
      "!documentation/",
      "!tools/",
      "!runtimes/",
      "!src_python/",
      "!pytest.ini",
      "!.flake8",
      "!.hintrc",
      "!.npmrc",
      "!.gitignore",
      "!.gitattributes",
      "!todo.txt",
      "!*.log",
      "!node_modules/",
      "!dist/",
      "!build/",
      "!.git/",
      "!.github/",
      "!.vscode/"
    ],
    "extraResources": [
      {
        "from": "./src_python",
        "to": "backend/src",
        "filter": [
          "**/*",
          "!**/*.test.py",
          "!**/tests/",
          "!**/test/",
          "!**/__pycache__/",
          "!**/.pytest_cache/",
          "!requirements-test.txt",
          "!pytest.ini",
          "!.coverage",
          "!htmlcov/"
        ]
      },
      {
        "from": "./runtimes/${platform}/python",
        "to": "backend/runtime",
        "filter": ["**/*"]
      }
    ],
    "extraFiles": [],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64", "ia32"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "icone.ico",
      "requestedExecutionLevel": "asInvoker",
      "publisherName": "NEPEM-UFSC",
      "verifyUpdateCodeSignature": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "zip",
          "arch": ["x64", "arm64"]
        }
      ],
      "icon": "icone.icns",
      "category": "public.app-category.education",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "deb",
          "arch": ["x64"]
        }
      ],
      "icon": "icone.ico",
      "category": "Science"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "icone.ico",
      "uninstallerIcon": "icone.ico",
      "installerHeaderIcon": "icone.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AIpomoea",
      "runAfterFinish": false,
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": true,
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "${productName}-${version}-Portable.${ext}"
    },
    "compression": "maximum",
    "removePackageScripts": true,
    "nodeGypRebuild": false,
    "buildDependenciesFromSource": false
  }
}
